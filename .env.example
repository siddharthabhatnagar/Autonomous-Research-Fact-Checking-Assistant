# Autonomous Research & Fact-Checking Assistant Environment Configuration

# LLM Provider selection: "groq", "nvidia", or "simulated"
LLM_PROVIDER=groq

# Groq API Configuration (Fast inference, recommended)
# Get a free key at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# NVIDIA AI Endpoints Configuration (Alternative)
# Get a key at https://build.nvidia.com
NVIDIA_API_KEY=nvapi_your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Search API Configuration (Optional - DuckDuckGo & Wikipedia work out-of-the-box without keys)
# Get a key at https://tavily.com
TAVILY_API_KEY=

# Server Configuration
HOST=127.0.0.1
PORT=8000
